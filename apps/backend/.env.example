# --- database ---
DATABASE_URL=postgres://nearodds:nearodds@localhost:5440/nearodds
# --- NEAR ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Neardata (FastNEAR) block source. Testnet needs no key today; set the key if your plan requires one.
NEARDATA_URL=https://testnet.neardata.xyz
NEARDATA_API_KEY=
# --- API ---
API_PORT=4000
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
# Comma separated NEAR accounts allowed to use /v1/admin/*
ADMIN_ACCOUNTS=nearodds-deploy.testnet
# NEP-413 recipient the wallet must sign for
AUTH_RECIPIENT=nearodds.app
SESSION_TTL_SECONDS=86400
# --- keeper signers (secrets stay OUT of git; files are read from KEYSTORE_DIR, mode 0600) ---
KEYSTORE_DIR=./.keystore
# Deployer = parent of market subaccounts. Credentials JSON as written by near-cli: ~/.near-credentials/testnet/<id>.json
DEPLOYER_ACCOUNT=nearodds-deploy.testnet
DEPLOYER_CREDENTIALS_FILE=
# Resolver / token owner. Defaults to the deployer: key isolation is NOT claimed unless these differ.
RESOLVER_ACCOUNT=nearodds-deploy.testnet
RESOLVER_CREDENTIALS_FILE=
TOKEN_OWNER_ACCOUNT=nearodds-deploy.testnet
TOKEN_OWNER_CREDENTIALS_FILE=
# --- approved artifacts: JSON array [{id,version,path,sha256,sourceVersion}] ---
APPROVED_ARTIFACTS_FILE=./artifacts.json
# --- keeper funding (yoctoNEAR) ---
MARKET_FUNDING_YOCTO=6000000000000000000000000
# --- faucet (testnet only) ---
FAUCET_ENABLED=true
FAUCET_TOKEN_ID=tok-demo-3879869.nearodds-deploy.testnet
FAUCET_COOLDOWN_SECONDS=60
FAUCET_AMOUNT=100000000
FAUCET_PER_ACCOUNT_LIMIT=300000000
FAUCET_GLOBAL_DAILY_LIMIT=10000000000
FAUCET_NEAR_BUDGET_YOCTO=500000000000000000000000
# --- tx handling ---
TX_POLL_TIMEOUT_MS=90000
RPC_READ_RETRIES=4
