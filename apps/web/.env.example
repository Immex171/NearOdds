# You normally do NOT write this file by hand.
# `pnpm dev` and `pnpm build` run scripts/sync-deployment.mjs first, which derives and validates these values from
# ../../deployments/testnet-demo.json and writes them to apps/web/.env (git-ignored). Run it manually with:
#   pnpm deployment:sync      write .env
#   pnpm deployment:check     validate the manifest AND compare it with the chain (get_config, ft_metadata, code hashes)
# An explicit value that disagrees with the manifest fails the run; only the RPC URL may be overridden.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_MARKET_CONTRACT_ID=mkt-demo-3879869.nearodds-deploy.testnet
NEXT_PUBLIC_TOKEN_CONTRACT_ID=tok-demo-3879869.nearodds-deploy.testnet
NEXT_PUBLIC_MARKET_ID=mkt-1
