# apps/web configuration. Markets, contracts and tokens are NOT configured here: the NearOdds backend lists every market
# contract and each API response names its contract, market id and token. The wallet then verifies each selected market
# against the chain before enabling transactions.
#
# `pnpm dev` / `pnpm build` run scripts/sync-deployment.mjs first. It validates deployments/testnet-demo.json (and, with
# `pnpm deployment:check`, compares it with the chain) and writes apps/web/.env (git-ignored) with the values below.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
# Origin of the NearOdds backend (apps/backend). Empty = live mode off, demo data only.
# The backend must list this web origin in its CORS allow-list (CORS_ORIGINS).
NEXT_PUBLIC_API_URL=http://localhost:4000
